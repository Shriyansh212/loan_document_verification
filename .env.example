# Environment Configuration for Document Verification Pipeline

# Groq API Key (Sign up for a free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
LOG_LEVEL=info

# Database Path (defaults to kyc_verification.db in project root)
DATABASE_PATH=kyc_verification.db
